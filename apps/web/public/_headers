# Cloudflare statik varliklar basliklari (derlemede out/_headers olur).
# Tum yollar
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Icerik karmali (degismez) dosyalar
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: her seferinde yeniden dogrulanir (Workers varsayilani; acikca sabitlenir)
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate

# B7: Pyodide cekirdegi ve model paketi surumlu/icerik adli: degismez (Service Worker ayrica on onbellege alir)
/pyodide/0.27.7/*
  Cache-Control: public, max-age=31536000, immutable
/oyun/oyun-*.zip
  Cache-Control: public, max-age=31536000, immutable

# B7: her seferinde yeniden dogrulanir (Service Worker, surum bilgisi, on onbellek listesi)
/sw.js
  Cache-Control: no-cache
/oyun/manifest.json
  Cache-Control: no-cache
/oyun/oyun-onbellek.json
  Cache-Control: no-cache
